NODE_ENV=development
PORT=3000
LOG_LEVEL=info

POSTGRES_URL=postgresql://postgres:password@localhost:5432/kobomarket
MONGODB_URI=mongodb://localhost:27017/kobomarket
REDIS_URL=redis://localhost:6379

# Replace this example with a randomly generated secret of at least 32 characters.
JWT_SECRET=replace-this-example-with-a-random-secret-at-least-32-chars

EMAIL_VERIFICATION_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=3600000
COMMISSION_BPS=500
